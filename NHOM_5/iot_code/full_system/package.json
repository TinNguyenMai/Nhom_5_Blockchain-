{
  "name": "p2p-solar-phase4",
  "version": "4.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "compile": "node blockchain/compile.mjs",
    "chain": "hardhat node --hostname 127.0.0.1",
    "deploy": "node blockchain/deploy.mjs",
    "demo:backend": "node blockchain/bridge.mjs replay",
    "demo:hardware": "node blockchain/hardware-demo.mjs",
    "market:live": "node blockchain/bridge.mjs live",
    "market:report": "node blockchain/report.mjs",
    "market:settle": "node blockchain/settle.mjs",
    "market:confirm": "node blockchain/admin.mjs confirm",
    "market:priority": "node blockchain/admin.mjs priority",
    "market:expire": "node blockchain/admin.mjs expire",
    "test": "node blockchain/run-tests.mjs",
    "test:integration": "node blockchain/test-integration.mjs",
    "dashboard": "node dashboard/server.mjs",
    "dashboard:build": "vite build --config dashboard/vite.config.mjs",
    "test:phase4": "node dashboard/tests/run.mjs",
    "simulation:hybrid": "node blockchain/simulation-market.mjs --scenario hybrid --serve-only",
    "test:hybrid": "node --test blockchain/tests/hybrid.test.mjs",
    "test:hybrid:ui": "node dashboard/tests/hybrid.mjs",
    "simulation:market": "node blockchain/simulation-market.mjs",
    "simulation:dashboard": "node blockchain/simulation-market.mjs --serve-only",
    "test:simulation": "node blockchain/test-simulation.mjs",
    "test:simulation:ui": "node dashboard/tests/simulation.mjs",
    "test:community": "node --test blockchain/tests/community.test.mjs",
    "test:community:ui": "node dashboard/tests/community.mjs"
  },
  "devDependencies": {
    "@openzeppelin/contracts": "5.4.0",
    "ethers": "6.17.0",
    "hardhat": "3.18.0",
    "solc": "0.8.28",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "vite": "8.3.1",
    "@vitejs/plugin-react": "6.1.1",
    "@playwright/test": "1.63.0"
  }
}
