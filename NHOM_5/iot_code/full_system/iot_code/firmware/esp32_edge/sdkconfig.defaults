CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
# Keep this disabled because the project path contains spaces; PlatformIO splits
# ESP-IDF's generated -fmacro-prefix-map argument at those spaces.
# CONFIG_COMPILER_HIDE_PATHS_MACROS is not set
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
CONFIG_FREERTOS_HZ=1000
CONFIG_SOLAR_MQTT_URI="mqtt://192.168.2.5:1885"
